PORT=4000

# --- MySQL connection (used by backend/db.js) ---
# Local development example:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_system

# Railway MySQL: open your MySQL service → Variables tab and map:
#   MYSQLHOST      → DB_HOST
#   MYSQLPORT      → DB_PORT
#   MYSQLUSER      → DB_USER
#   MYSQLPASSWORD  → DB_PASSWORD
#   MYSQLDATABASE  → DB_NAME (use inventory_system after running backend/sql/*.sql)
#
# Example (replace with values from Railway):
# DB_HOST=containers-us-west-xxx.railway.app
# DB_PORT=12345
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=inventory_system

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=your_jwt_secret_key_here
